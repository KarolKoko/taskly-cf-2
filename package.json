    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "pg": "^8.23.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "homepage": "https://github.com/cf-recruitment/taskly-app-node#readme",
  "dependencies": {
    "cheerio": "^1.2.0",
