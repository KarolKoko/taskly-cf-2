{
  "name": "taskly-cf",
  "version": "1.0.0",
  "description": "```sh\r cp .env.example .env\r ```",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "typecheck": "tsc --noEmit",
    "sanity-check": "tsx scripts/sanity-check.ts",
    "pr-tests": "npm test",
    "docs:scrape": "tsx index.ts",
    "generate:tests": "tsx generator/index.ts",
    "generate:tests:plan": "tsx generator/index.ts --plan-only",
    "test:generated": "tsx scripts/run-generated-tests.ts",
    "stage:generated": "tsx scripts/stage-generated-tests.ts",
    "apply:generated": "tsx scripts/apply-generated-tests.ts",
    "tests:gen": "npm run generate:tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cf-recruitment/taskly-app-node.git"
  },
